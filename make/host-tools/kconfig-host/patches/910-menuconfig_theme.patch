+/*
+ * Charcoal surfaces and cool accents. Keep a basic palette for terminals
+ * that do not provide the standard 256-color palette.
+ */
+static void set_dark_theme(void)
+{
+	const bool extended = COLORS >= 256;
+	const int background = extended ? 234 : COLOR_BLACK;
+	const int panel = extended ? 235 : COLOR_BLACK;
+	const int shadow = extended ? 232 : COLOR_BLACK;
+	const int foreground = extended ? 252 : COLOR_WHITE;
+	const int muted = extended ? 244 : COLOR_WHITE;
+	const int border = extended ? 240 : COLOR_WHITE;
+	const int accent = extended ? 80 : COLOR_CYAN;
+	const int selection = extended ? 24 : COLOR_BLUE;
+	const int selected = extended ? 255 : COLOR_WHITE;
+	const int check = extended ? 114 : COLOR_GREEN;
+
+	DLG_COLOR(screen,                muted,      background, false);
+	DLG_COLOR(shadow,                shadow,     shadow,     false);
+	DLG_COLOR(dialog,                foreground, panel,      false);
+	DLG_COLOR(title,                 accent,     panel,      true);
+	DLG_COLOR(border,                border,     panel,      false);
+
+	DLG_COLOR(button_active,         selected,   selection,  true);
+	DLG_COLOR(button_inactive,       foreground, panel,      false);
+	DLG_COLOR(button_key_active,     accent,     selection,  true);
+	DLG_COLOR(button_key_inactive,   accent,     panel,      true);
+	DLG_COLOR(button_label_active,   selected,   selection,  true);
+	DLG_COLOR(button_label_inactive, foreground, panel,      false);
+
+	DLG_COLOR(inputbox,              selected,   background, false);
+	DLG_COLOR(position_indicator,    muted,      panel,      false);
+	DLG_COLOR(menubox,               foreground, panel,      false);
+	DLG_COLOR(menubox_border,        border,     panel,      false);
+
+	DLG_COLOR(item,                  foreground, panel,      false);
+	DLG_COLOR(item_selected,         selected,   selection,  false);
+	DLG_COLOR(tag,                   accent,     panel,      false);
+	DLG_COLOR(tag_selected,          accent,     selection,  true);
+	DLG_COLOR(tag_key,               accent,     panel,      true);
+	DLG_COLOR(tag_key_selected,      accent,     selection,  true);
+	DLG_COLOR(check,                 check,      panel,      true);
+	DLG_COLOR(check_selected,        check,      selection,  true);
+	DLG_COLOR(uarrow,                accent,     panel,      false);
+	DLG_COLOR(darrow,                accent,     panel,      false);
+}
+
