#!/bin/sh
# Register Celllock as a native Freetz configuration page.
# The conf handler requires /mod/etc/default.celllock/celllock.cfg
# and embeds /mod/usr/lib/cgi-bin/celllock.cgi in its page layout.

case "$1" in
    ""|load|start|restart|reload|config)
        modreg pkg celllock '5G Celllock'
        modreg conf celllock _index 'Celllock'
        ;;
    unload|stop)
        modunreg conf celllock
        modunreg pkg celllock
        ;;
    *)
        echo "Usage: $0 [load|unload]" >&2
        exit 1
        ;;
esac
exit 0
