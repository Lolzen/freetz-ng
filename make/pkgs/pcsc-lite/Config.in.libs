config FREETZ_LIB_libpcsclite
	bool "libpcsclite (libpcsclite.so)"
	select FREETZ_LIB_libpthread  if FREETZ_TARGET_UCLIBC_HAS_multiple_libs
	select FREETZ_LIB_librt       if FREETZ_TARGET_UCLIBC_HAS_multiple_libs
	default n
	help
		Middleware to access smart cards using PC/SC.

	choice
		prompt "Version" if FALSE
			default FREETZ_LIB_libpcsclite_WITH_VERSION_CURRENT

		config FREETZ_LIB_libpcsclite_WITH_VERSION_ABANDON
			bool "1.9.5"
			depends on FREETZ_TARGET_GCC_4_MAX
			help
				The C11 atomics are available since GCC v4.9 only.

		config FREETZ_LIB_libpcsclite_WITH_VERSION_CURRENT
			bool "2.5.1"
			depends on !FREETZ_TARGET_GCC_4_MAX

	endchoice

