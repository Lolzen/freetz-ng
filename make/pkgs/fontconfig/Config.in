config FREETZ_PACKAGE_FONTCONFIG
	bool "Fontconfig 2.17.1/2.18.3 (binary only)"
	depends on FREETZ_LIB_libfontconfig
	default n
	help
		Fontconfig is a library for configuring and customizing
		font access. This package adds /etc/fontsfonts.conf

if FREETZ_PACKAGE_FONTCONFIG

	choice
		prompt "Version"
			default FREETZ_PACKAGE_FONTCONFIG_VERSION_CURRENT

		config FREETZ_PACKAGE_FONTCONFIG_VERSION_ABANDON
			bool "2.17.1"
			depends on FREETZ_LIB_libfontconfig_WITH_VERSION_ABANDON

		config FREETZ_PACKAGE_FONTCONFIG_VERSION_CURRENT
			bool "2.18.3"
			depends on FREETZ_LIB_libfontconfig_WITH_VERSION_CURRENT

	endchoice

endif # FREETZ_PACKAGE_FONTCONFIG

